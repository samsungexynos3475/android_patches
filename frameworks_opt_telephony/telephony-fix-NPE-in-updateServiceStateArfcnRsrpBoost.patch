 .../com/android/internal/telephony/ServiceStateTracker.java     | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/java/com/android/internal/telephony/ServiceStateTracker.java b/src/java/com/android/internal/telephony/ServiceStateTracker.java
index e2c6aa5cab5..9503f25ee32 100755
--- a/src/java/com/android/internal/telephony/ServiceStateTracker.java
+++ b/src/java/com/android/internal/telephony/ServiceStateTracker.java
@@ -5305,6 +5305,8 @@ private void updateServiceStateArfcnRsrpBoost(ServiceState serviceState,
         int rsrpBoost = 0;
         int arfcn;
 
+        if (cellIdentity == null) return;
+
         synchronized (mRsrpBoostLock) {
             switch (cellIdentity.getType()) {
                 case CellInfo.TYPE_LTE:
